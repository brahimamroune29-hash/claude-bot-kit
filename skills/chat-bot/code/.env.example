# copy to .env (never commit .env)
PORT=3000
DB_PATH=./bot.db
CARD_PATH=./card.json
# DRY_RUN=1 prints replies instead of sending them (and opens the local trial chat at /try)
DRY_RUN=1
# only these numbers get replies until launch (comma-separated digits, empty = everyone)
TEST_NUMBERS=
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
# required even for DRY_RUN and the /try page: without it the bot cannot write a reply
OPENROUTER_API_KEY=
MODEL=anthropic/claude-haiku-5.5
DAILY_COST_CAP_USD=3
# the owner's WhatsApp in international digits (e.g. 2135XXXXXXXX): new orders, handoffs and problems go here
AGENT_PHONE=
DASHBOARD_PASSWORD=
# product photos: put the files here (plain names like p2-black.jpg) and list them in card.json under "photos"
MEDIA_DIR=./media
# daily database copies (7 kept); in production under data/
BACKUP_DIR=./backups
# the bot's public https address, no trailing slash (Wasender and Meta fetch product photos from PUBLIC_URL/media/...)
PUBLIC_URL=
# voice notes are transcribed by OpenAI; text replies stay on OpenRouter (MODEL)
OPENAI_API_KEY=
# Instagram + Messenger through the shop's Facebook Page (steps in deploy/META.md). All three, or empty = WhatsApp only
META_PAGE_TOKEN=
META_APP_SECRET=
# any long random string; the same one goes in the Meta app's webhook settings
META_VERIFY_TOKEN=
# warn the owner on WhatsApp when the OpenRouter balance drops under this (USD)
LOW_BALANCE_USD=2
